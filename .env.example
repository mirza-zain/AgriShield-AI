# ==============================================================================
# AgriShield AI - Environment Variables
# ==============================================================================

# 1. Google Gemini AI (Vision Pathology, Prescriptions, Spoken Audio TTS)
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Firebase Admin Service Account (Firestore Database for Scans & Community Feed)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. Cloudflare R2 Object Storage (Zero-Egress Global CDN for Crop Images)
# Get from Cloudflare Dashboard > R2 > Manage R2 API Tokens & Bucket Settings
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_secret_access_key"
CLOUDFLARE_R2_BUCKET="your-bucket-name"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
