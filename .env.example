# AgriShield AI Environment Variables

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client SDK Configuration (Optional - Get from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agrishield-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agrishield-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agrishield-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Admin Service Account Credentials (Optional)
FIREBASE_PROJECT_ID=agrishield-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@agrishield-ai.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
